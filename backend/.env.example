# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=UTC

# Database (local: Postgres via docker-compose / compose.yaml)
# DATABASE_URL takes priority when set, e.g.
#   DATABASE_URL=postgres://school_admin:school_password@localhost:5432/perfect_foundation
DB_ENGINE=django.db.backends.postgresql
DB_NAME=perfect_foundation
DB_USER=school_admin
DB_PASSWORD=school_password
DB_HOST=localhost
DB_PORT=5432

# Production HTTPS (only read by config.settings.production)
# DJANGO_SECURE_SSL_REDIRECT=0   # set to 0 when testing locally without a proxy
# DJANGO_SESSION_COOKIE_SECURE=0 # set to 0 with the above when testing locally over HTTP
# DJANGO_CSRF_COOKIE_SECURE=0

# Email
DEFAULT_FROM_EMAIL=no-reply@perfectfoundation.edu
# Transactional email (SMTP) for production:
# DJANGO_EMAIL_HOST=smtp.your-provider.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=your-smtp-username
# DJANGO_EMAIL_PASSWORD=your-smtp-password
# DJANGO_EMAIL_USE_TLS=1

# ---------------------------------------------------------------------------
# FEATURE ACTIVATION (all optional; features self-disable when unset)
# ---------------------------------------------------------------------------

# Scheduled jobs (Vercel Cron sends: Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=generate-a-long-random-string
# Late fees: applied daily by /api/finance/cron/late-fees/
# LATE_FEE_PERCENT=2            # % of outstanding balance  (or use FLAT)
# LATE_FEE_FLAT=200             # flat Rs per invoice       (overrides %)
# LATE_FEE_GRACE_DAYS=5

# Google Sign-In (Google Cloud Console -> OAuth client ID, type "Web")
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Biometric / RFID devices -> POST /api/attendance/device-sync/
# Comma-separated list of allowed device keys.
# ATTENDANCE_DEVICE_KEYS=device-key-1,device-key-2

# GPS trackers -> POST /api/transport/gps/ping/
# GPS_DEVICE_KEYS=gps-key-1

# JazzCash hosted checkout
# JAZZCASH_MERCHANT_ID=MC-XXXXX
# JAZZCASH_PASSWORD=your-jazzcash-password
# JAZZCASH_INTEGRITY_SALT=your-salt
# JAZZCASH_ENV=sandbox          # or "live"

# EasyPaisa (Easypay) hosted checkout
# EASYPAISA_STORE_ID=STORE-XXXXX
# EASYPAISA_STORE_KEY=your-store-key
# EASYPAISA_ENV=sandbox         # or "live"

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Stripe online payments
# STRIPE_SECRET_KEY=sk_live_...
