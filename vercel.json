{
  "buildCommand": "python manage.py migrate --noinput && python manage.py collectstatic --noinput",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/media/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/finance/cron/late-fees/",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/reports/cron/email-weekly/",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/attendance/cron/absence-alerts/",
      "schedule": "0 8 * * 1-6"
    },
    {
      "path": "/api/communication/cron/fee-reminders/",
      "schedule": "30 8 * * 1-6"
    },
    {
      "path": "/api/communication/cron/process-notifications/",
      "schedule": "0 9 * * *"
    }
  ]
}

